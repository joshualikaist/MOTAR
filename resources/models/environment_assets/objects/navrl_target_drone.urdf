<?xml version='1.0' encoding='UTF-8'?>
<!-- NavRL Phase-3 moving target: a small drone-sized body (~0.3 m footprint) that the pursuer
     must locate purely from its onboard sensors (semantic_id=50). Sized to be detectable by the
     coarse 36x4 LiDAR AND the depth+segmentation camera. fix_base_link + disable_gravity: the
     body is teleported kinematically each step by the task (no physics dynamics). -->
<robot name="navrl_target_drone">
  <link name="base_link">
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <mass value="0.25"/>
      <inertia ixx="0.004" ixy="0.0" ixz="0.0" iyy="0.004" iyz="0.0" izz="0.004"/>
    </inertial>
    <visual name="base_link_visual">
      <geometry>
        <box size="0.30 0.30 0.14"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="TargetRed">
        <color rgba="0.9 0.2 0.2 0.95"/>
      </material>
    </visual>
    <collision name="base_link_collision">
      <geometry>
        <box size="0.30 0.30 0.14"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
  </link>
</robot>
