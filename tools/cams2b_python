#!/usr/bin/env bash
# PYTHON for train_navrl_cams2b.sh (CAM-S2b, docs/plans/prereg_camonly_s2b_2026-11-24.md): sets the trained yaw-rate
# ceiling, then runs tools/realveh_python (tools/realveh_entry.py -> runner.py) unchanged.
#
# Why a wrapper: train_navrl_v2_search.sh pins `export NAVRL_YAW_RATE_MAX=3.0` (line 380) after every child launcher
# setting, and train_navrl.sh calls PYTHON exactly once, for runner.py. This is the last step before runner.py imports
# aerial_gym, where navrl_task_config.yaw_rate_max and lee_controller_config_navrl.max_yaw_rate both read
# NAVRL_YAW_RATE_MAX at import time (one variable keeps the action scale and the controller clamp equal).
# tools/realveh_entry.py then records the value in the receipt's env_navrl, and the task records it in every
# checkpoint as cfg_yaw_rate_max.
#
# Fail-closed: CAMS2B_YAW_RATE_MAX must be set and positive decimal; the inherited NAVRL_YAW_RATE_MAX must be the
# search launcher's 3.0 (so this wrapper can only replace the value it was written to replace); the evaluation-only
# switches (NAVRL_YAWCLIP*, NAVRL_CAMS2DIAG*, NAVRL_CAMS2_CONTACTCODE*) must be unset, because tools/realveh_entry.py
# installs them whenever they are set and training must run without them.
set -euo pipefail
: "${CAMS2B_YAW_RATE_MAX:?CAMS2B_YAW_RATE_MAX is required (train_navrl_cams2b.sh sets it)}"
if [[ ! "${CAMS2B_YAW_RATE_MAX}" =~ ^[0-9]+(\.[0-9]+)?$ ]] || [[ "${CAMS2B_YAW_RATE_MAX}" =~ ^0+(\.0+)?$ ]]; then
    echo "[cams2b-python] CAMS2B_YAW_RATE_MAX must be a positive decimal, got '${CAMS2B_YAW_RATE_MAX}'" >&2
    exit 2
fi
if [[ "${NAVRL_YAW_RATE_MAX:-}" != "3.0" ]]; then
    echo "[cams2b-python] expected the search launcher's NAVRL_YAW_RATE_MAX=3.0, got '${NAVRL_YAW_RATE_MAX:-<unset>}'" >&2
    exit 2
fi
for name in $(compgen -e); do
    case "${name}" in
        NAVRL_YAWCLIP*|NAVRL_CAMS2DIAG*|NAVRL_CAMS2_CONTACTCODE*)
            echo "[cams2b-python] evaluation-only switch ${name} is set; training refuses it" >&2
            exit 2 ;;
    esac
done
export NAVRL_YAW_RATE_MAX="${CAMS2B_YAW_RATE_MAX}"
echo "[cams2b-python] NAVRL_YAW_RATE_MAX 3.0 -> ${NAVRL_YAW_RATE_MAX} rad/s (action scale and Lee yaw clamp)"
exec "$(dirname "$(readlink -f "$0")")/realveh_python" "$@"
