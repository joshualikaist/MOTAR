#!/usr/bin/env bash
# PYTHON for play_navrl.sh in the camera-only study (D-2026-11-04-3): runs tools/camonly_entry.py with the real
# interpreter, which installs NAVRL_SENSOR_ABLATION and then runs runner.py unchanged. Use it only for the play
# command; every other helper keeps the real interpreter.
set -euo pipefail
REAL="${CAMONLY_REAL_PYTHON:?CAMONLY_REAL_PYTHON is required}"
# play_navrl.sh puts this wrapper's directory first on PATH; restore the interpreter's bin directory in front of it so
# tools that runner.py builds with (ninja for gymtorch) are found as in a native run (review r1 M3).
export PATH="$(dirname "${REAL}"):${PATH}"
exec "${REAL}" "$(dirname "$(readlink -f "$0")")/camonly_entry.py" "$@"
